    {
      "schema_version": "2.0",
      "section_id": "09",
      "title": "9. 具体实施方式",
      "paragraphs": [
        {
          "schema_version": "2.0",
          "paragraph_id": "DISC-09-P001",
          "section_id": "09",
          "text": "预期在合成演示实施例中，依次获取多源信号、完成时间同步与状态融合，并根据状态偏差生成控制参数修正量。",
          "evidence_ids": [
            "EV-DOCD415652CC4-0007-89a47e37"
          ],
          "fact_ids": [
            "FACT-S001",
            "FACT-S002",
            "FACT-S003",
            "FACT-S004",
            "FACT-S005"
          ],
          "derived_from": [
            "FACT-S001",
            "FACT-S002",
            "FACT-S003",
            "FACT-S004",
            "FACT-S005"
          ],
          "status": "INFERRED",
          "human_modified": false,
          "review_status": "UNREVIEWED",
          "locked": false
        },
        {
          "schema_version": "2.0",
          "paragraph_id": "DISC-09-P002",
          "section_id": "09",
          "text": "SYNTHETIC DEMO DATA：在人工构造的传感噪声场景下，与等权融合演示基线相比，状态估计均方误差由0.082降至0.061；该数值仅用于测试证据标记、表述和校验，不得作为真实实验结果或申请事实。",
          "evidence_ids": [
            "EV-DOCD415652CC4-0010-7bfee3fc"
          ],
          "fact_ids": [
            "FACT-EXP-001"
          ],
          "derived_from": [
            "FACT-EXP-001"
          ],
          "status": "SOURCE_FACT",
          "human_modified": false,
          "review_status": "UNREVIEWED",
          "locked": false
        }
      ]
    },
    {
      "schema_version": "2.0",
      "section_id": "10",
      "title": "10. 可替代实施方式",
      "paragraphs": [
        {
          "schema_version": "2.0",
          "paragraph_id": "DISC-10-P001",
          "section_id": "10",
          "text": "状态采集单元可仅使用振动、电流和温度中的两种信号。",
          "evidence_ids": [
            "EV-DOCD415652CC4-0011-3b77a576"
          ],
          "fact_ids": [
            "FACT-A001",
            "FACT-A002",
            "FACT-A003"
          ],
          "derived_from": [
            "FACT-A001",
            "FACT-A002",
            "FACT-A003"
          ],
          "status": "SOURCE_FACT",
          "human_modified": false,
          "review_status": "UNREVIEWED",
          "locked": false
        },
        {
          "schema_version": "2.0",
          "paragraph_id": "DISC-10-P002",
          "section_id": "10",
          "text": "置信度权重可由信噪比、缺失率或传感器自检状态确定。",
          "evidence_ids": [
            "EV-DOCD415652CC4-0011-3b77a576"
          ],
          "fact_ids": [
            "FACT-A001",
            "FACT-A002",
            "FACT-A003"
          ],
          "derived_from": [
            "FACT-A001",
            "FACT-A002",
            "FACT-A003"
          ],
          "status": "SOURCE_FACT",
          "human_modified": false,
          "review_status": "UNREVIEWED",
          "locked": false
        },
        {
          "schema_version": "2.0",
          "paragraph_id": "DISC-10-P003",
          "section_id": "10",
          "text": "控制处理单元可采用PI控制、模型预测控制或其他有来源支持的控制方式。",
          "evidence_ids": [
            "EV-DOCD415652CC4-0011-3b77a576"
          ],
          "fact_ids": [
            "FACT-A001",
            "FACT-A002",
            "FACT-A003"
          ],
          "derived_from": [
            "FACT-A001",
            "FACT-A002",
            "FACT-A003"
          ],
          "status": "SOURCE_FACT",
          "human_modified": false,
          "review_status": "UNREVIEWED",
          "locked": false
        }
      ]
    },
    {
      "schema_version": "2.0",
      "section_id": "11",
      "title": "11. 关键创新点与拟保护点",
      "paragraphs": [
        {
          "schema_version": "2.0",
          "paragraph_id": "DISC-11-P001",
          "section_id": "11",
